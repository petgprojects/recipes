# Copy to .env (git-ignored) and fill in. PLAN.md §3.
#
# The authoritative list is packages/shared/src/env.ts — it is Zod-validated and
# the app refuses to boot on a bad value rather than throwing mid-scan. Keep the
# two in sync.

# ── Required from Phase 0 ────────────────────────────────────────────────────
# Host-side value: what `pnpm dev` / psql / drizzle-studio use against the
# published port of the `db` container. docker-compose.yml overrides this with
# host `db` for the containers themselves — both need to be correct.
DATABASE_URL=postgresql://recipes:recipes@localhost:5432/recipes
NODE_ENV=development

# ── Phase 0 — docker compose ─────────────────────────────────────────────────
# Postgres credentials the `db` service is created with. Changing these after
# the first `up` requires `docker compose down -v` (the volume keeps the old
# ones) and must be kept in sync with DATABASE_URL above.
POSTGRES_USER=recipes
POSTGRES_PASSWORD=recipes
POSTGRES_DB=recipes
# Host ports. Change if something already owns 5432 or 3000 locally.
DB_PORT=5432
WEB_PORT=3000

# ── Phase 1 — image pipeline ─────────────────────────────────────────────────
# Where the worker writes downscaled recipe photos and web reads them from.
# Under compose this is the shared `recipe-images` volume and is set for you;
# uncomment only when running the worker natively.
# RECIPE_IMAGES_DIR=./data/images

# Daily deterministic scan. These defaults are also enforced by the validated
# env module, so all four may be omitted. Set SCAN_BOOTSTRAP_ENABLED=false for
# a startup smoke test that must not crawl live sites.
SCAN_CRON_SCHEDULE=0 3 * * *
SCAN_CRON_TIMEZONE=America/New_York
SCAN_DISCOVERY_LIMIT=200
SCAN_BOOTSTRAP_ENABLED=true

# ── Phase 2 — LLM enrichment ─────────────────────────────────────────────────
# PROGRESS.md amendment A1: the provider is OpenRouter, not DeepSeek direct.
# There is no DEEPSEEK_API_KEY. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Hard-stops a scan when the day's spend exceeds this.
LLM_DAILY_BUDGET_USD=1.00

# ── Phase 2 — Reddit ─────────────────────────────────────────────────────────
# https://reddit.com/prefs/apps — see the blocker note in PROGRESS.md.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# ── Phase 4 — Auth.js + Google ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32
AUTH_SECRET=
# Treat an unauthenticated development request as the seeded `dev@local` user
# (PLAN.md §4). Off by default — with it on you are permanently signed in, so
# the signed-out planner and the first-sign-in migration become unreachable.
# See PROGRESS.md amendment A15. Ignored when NODE_ENV=production.
DEV_AUTH_FALLBACK=false
# Auth.js's public origin. docker-compose.yml sets this for the containers; set
# it here only if you run `pnpm dev` on the host with a non-default host/port.
# It must never be `http://0.0.0.0:...` — Google rejects that redirect_uri as an
# OAuth policy violation, and only at the token-exchange step, so the failure
# looks like a server error rather than a bad URL. See PROGRESS.md amendment A16.
AUTH_URL=http://localhost:3000

# ── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
